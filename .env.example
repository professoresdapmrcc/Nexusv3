# Origem pública do Nexus, sem barra ou caminho adicional.
NEXUS_APP_URL=https://nexus.exemplo.com.br

# O Atlas permanece como issuer e host de autorização. O gateway auth é
# confiado apenas para token, UserInfo e JWKS.
ATLAS_OIDC_ISSUER=https://issuer.rccsystem.invalid
ATLAS_OIDC_TRUSTED_ENDPOINT_ORIGINS=https://auth.rccsystem.invalid
ATLAS_OIDC_CLIENT_ID=oidc_...
ATLAS_OIDC_CLIENT_SECRET=substitua-pelo-segredo-do-cliente

# Gere valores independentes e aleatórios com pelo menos 32 bytes.
ATLAS_OIDC_TRANSACTION_SECRET=substitua-por-um-segredo-aleatorio-longo
NEXUS_AUTH_BRIDGE_SECRET=substitua-por-outro-segredo-aleatorio-longo

# JSON completo da conta de serviço do Firebase, em uma única linha.
# Nunca exponha este valor no navegador, no Git ou em variáveis NEXT_PUBLIC.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
